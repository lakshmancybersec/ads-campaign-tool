# Application
APP_NAME=Lakshiya Dhotis Ads Agent
ENVIRONMENT=development
LOG_LEVEL=INFO
API_ADMIN_KEY=replace-with-a-long-random-value

# Database
# Local development default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./lakshiya_ads.db

# Business safety defaults (may be overridden through approved configuration later)
DAILY_BUDGET_INR=150
WEEKLY_BUDGET_INR=1050
WEEKLY_BUDGET_SAFETY_PERCENT=100
TIMEZONE=Asia/Kolkata

# Meta Marketing API (leave blank until live integration)
META_ACCESS_TOKEN=
# Select a supported version for your Meta app before live verification.
META_API_VERSION=v22.0
# Keep false until account checks, paused preparation and scheduler setup are reviewed.
META_LIVE_WRITES_ENABLED=false
FACEBOOK_PAGE_ID=
INSTAGRAM_ACTOR_ID=
# Customer destination, including country code, digits only (not the owner alert number).
CUSTOMER_WHATSAPP_NUMBER=
META_AD_ACCOUNT_ID=
META_APP_SECRET=
META_APP_ID=
META_BUSINESS_MANAGER_ID=
FACEBOOK_PAGE_URL=
COMMERCE_BUSINESS_ID=
# This is the catalog ID, not the Commerce Business ID.
META_CATALOG_ID=
STOREFRONT_URL=

# WhatsApp Cloud API (leave blank until live integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
PUBLIC_DASHBOARD_URL=

# Built-in worker runs only when live Meta writes are enabled.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Email (leave blank until live integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
OWNER_EMAIL=
OWNER_WHATSAPP_NUMBER=919043608303

# Allows paused ad creation only; activation still requires live writes.
META_PAUSED_PREPARATION_ENABLED=false
